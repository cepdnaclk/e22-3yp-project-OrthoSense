# ========================================================
# OrthoSense Backend Environment Variables Template
# Copy this file to .env and configure local values.
# DO NOT commit .env with real credentials to source control.
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
HOST=0.0.0.0

# CORS Allowed Origin (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# Database Credentials
DATABASE_URL=postgresql://orthosense_user:password_here@localhost:5432/orthosense_db

# JWT & Authentication Secret
JWT_SECRET=super_secret_jwt_token_change_in_production
JWT_EXPIRES_IN=7d

# MQTT Broker (for ESP32-S3 Telemetry Streaming)
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_TOPIC_TELEMETRY=orthosense/device/+/telemetry
MQTT_TOPIC_COMMANDS=orthosense/device/+/commands
MQTT_CLIENT_ID=orthosense_backend_server

# Safety Thresholds for Telemetry Alerts
MAX_KNEE_FLEXION_ANGLE=140
MIN_KNEE_EXTENSION_ANGLE=0
MAX_CONTACT_PRESSURE_KPA=50

